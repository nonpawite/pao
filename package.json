{
  "name": "app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:push": "bun --bun drizzle-kit push",
    "db:pull": "bun --bun drizzle-kit pull",
    "db:studio": "bun --bun drizzle-kit studio",
    "test": "bun test src/lib",
    "test:db": "BETTER_AUTH_URL=https://pao.test ALLOW_SIGNUP=true SMTP_URL=smtp://pao%40pao.test@127.0.0.1:1 bun test ./src/server/sign-in.dbtest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
